# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (used in confirmation and reset emails)
NEXT_PUBLIC_APP_URL=https://www.trimtrack.fit

# Resend (email reminders and confirmation)
RESEND_API_KEY=your_resend_api_key

# Stripe - monthly 4.99 GBP, yearly billed as 3.19/month (38.28/year)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Optional public copies of the price ids (used by the upgrade modal)
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID=

# Meal scan: Claude first. ChatGPT (gpt-4o) is used if Claude fails
# or ANTHROPIC_API_KEY is missing. Google Vision is not used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# USDA FoodData Central (free key from https://fdc.nal.usda.gov/api-guide)
# Used when a scanned dish is not in the Nigerian catalog or Open Food Facts.
USDA_FDC_API_KEY=
